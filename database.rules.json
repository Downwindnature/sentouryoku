{
  "rules": {
    "pages": {
      ".read": true,
      ".write": "auth != null",
      "$pid": {
        ".validate": "newData.hasChildren(['name'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        }
      }
    },
    "ratings": {
      ".read": true,
      ".write": "auth != null"
    },
    "entries": {
      ".read": true,
      ".write": "auth != null",
      "$pid": {
        "$eid": {
          ".validate": "newData.hasChildren(['name', 'updatedAt'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
          },
          "power": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "html": {
            ".validate": "newData.isString() && newData.val().length <= 1000000"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "updatedBy": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "pinnedAt": {
            ".validate": "newData.isNumber()"
          }
        }
      }
    },
    "history": {
      ".read": true,
      ".write": "auth != null"
    },
    "media": {
      ".read": true,
      ".write": "auth != null"
    },
    "mediaThumb": {
      ".read": true,
      ".write": "auth != null"
    },
    "mediaData": {
      ".read": true,
      ".write": "auth != null"
    }
  }
}
